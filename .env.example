# Server-only world-director credentials. Do not prefix with VITE_.
# If these are empty, the API uses a heuristic director so the demo still runs.

LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Environment rendering mode:
#   PROCEDURAL_360   — LLM → JSON scene params → runtime renderer (default test mode)
#   IMAGE_GENERATION — LLM → image model → 360 panorama (existing path, kept intact)
ENVIRONMENT_MODE=PROCEDURAL_360

# Image generation (360° panoramas). Used only when ENVIRONMENT_MODE=IMAGE_GENERATION.
# Falls back to LLM/OpenAI key if IMAGE_API_KEY is empty.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_GENERATION_COUNT=3
IMAGE_QUALITY=high
IMAGE_SIZE=1536x1024
IMAGE_TIMEOUT_MS=120000
GENERATED_ASSET_DIR=public/generated

# Optional shared rate-limit store. Leave empty for in-memory (local dev).
REDIS_URL=

# Standalone API (Heroku). PORT is set automatically on Heroku.
PORT=3000
# Comma-separated browser origins allowed to call the API.
# Empty = allow any origin. Example: https://your-app.netlify.app,http://localhost:5173
CORS_ORIGINS=

# Frontend (Netlify build). Leave empty for local Vite (same-origin /api via plugin).
# Example: https://your-app.herokuapp.com
VITE_API_BASE_URL=

# World planning rate limits (anonymous / IP)
WORLD_RATE_LIMIT_PER_MINUTE=10
WORLD_RATE_LIMIT_PER_10_MINUTES=30
WORLD_RATE_LIMIT_PER_HOUR=100
WORLD_RATE_LIMIT_BUDGET_PER_10_MINUTES=5
WORLD_RATE_LIMIT_PER_DAY=20

# Asset generation rate limits
GENERATION_RATE_LIMIT_PER_MINUTE=5
GENERATION_RATE_LIMIT_PER_DAY=20

# Authenticated quotas (used only if a trusted getUserId hook is wired later)
AUTH_WORLD_RATE_LIMIT_PER_MINUTE=20
AUTH_WORLD_RATE_LIMIT_PER_DAY=40
AUTH_GENERATION_RATE_LIMIT_PER_MINUTE=10

# World-size and request limits
MAX_ROOMS=3
MAX_OBJECTS_PER_ROOM=20
MAX_HOTSPOTS_PER_ROOM=10
MAX_GENERATED_ASSETS_PER_WORLD=10
MAX_PROMPT_LENGTH=1000
MAX_DESCRIPTION_LENGTH=240
MAX_REQUEST_BODY_BYTES=8192
